# Copie para .env.local e preencha. Nada aqui é enviado ao navegador.
# Sem nenhuma chave o app roda em "modo demonstração".

# --- IA de conteúdo (obrigatória para conteúdo real) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Opcional. Padrão: claude-opus-5-5 (mais barato: claude-sonnet-5-5)
ANTHROPIC_MODEL=claude-opus-5-5

# --- Narração (escolha UMA; sem nenhuma, usa a voz do navegador) ---
# OpenAI TTS: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=nova
# ElevenLabs: https://elevenlabs.io/app/settings/api-keys  (voz: Voice Library -> copiar Voice ID)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Se as duas estiverem definidas: openai | elevenlabs
TTS_PROVIDER=

# --- Render de MP4 (Remotion) ---
# auto = liga fora de Vercel/Netlify. true/false para forçar.
RENDER_MP4=auto
# Opcional: caminho de um Chrome/Chromium. Vazio = o Remotion baixa o dele.
REMOTION_BROWSER_EXECUTABLE=
# Opcional: custo estimado (US$) por minuto de vídeo renderizado, para o painel de custos.
RENDER_COST_PER_MIN=0

# --- Armazenamento local (Fase 1) ---
DATA_DIR=.data

# --- Fases seguintes ---
# Fase 2: SUPABASE_URL= / SUPABASE_ANON_KEY= / SUPABASE_SERVICE_ROLE_KEY=
# Fase 3: YOUTUBE_API_KEY=
YOUTUBE_API_KEY=
